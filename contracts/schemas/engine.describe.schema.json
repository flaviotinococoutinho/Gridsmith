{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p7m://contracts/engine.describe",
  "title": "engine/describe",
  "description": "Manifesto de capacidades da engine (middleware → engine). A engine descreve seus subsistemas, limites e layouts binários; o middleware projeta isso como conceitos de edição visual para o editor Electron. Os offsets de vértice são gerados por reflexão real das structs — nunca hardcoded.",
  "type": "object",
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "protocolVersion": { "type": "string" }
          },
          "required": ["name", "version", "protocolVersion"]
        },
        "subsystems": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": { "enum": ["available", "planned"] },
              "phase": { "type": "integer", "minimum": 1, "maximum": 5 },
              "limits": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              },
              "features": {
                "type": "array",
                "items": { "type": "string" }
              },
              "vertexLayouts": {
                "type": "array",
                "items": { "$ref": "#/$defs/vertexLayout" }
              },
              "editor": { "$ref": "#/$defs/editorHints" }
            },
            "required": ["status"]
          }
        }
      },
      "required": ["engine", "subsystems"]
    }
  },
  "$defs": {
    "vertexLayout": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "layoutVersion": { "type": "integer", "minimum": 1 },
        "strideInBytes": { "type": "integer", "minimum": 4 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "offset": { "type": "integer", "minimum": 0 },
              "type": { "enum": ["float", "float2", "float3", "float4", "byte4", "uint"] },
              "semantic": { "type": "string" }
            },
            "required": ["name", "offset", "type", "semantic"]
          }
        }
      },
      "required": ["name", "layoutVersion", "strideInBytes", "fields"]
    },
    "editorHints": {
      "type": "object",
      "description": "Como o subsistema se apresenta no editor visual: painéis, gizmos e tipos de nó que a UI deve materializar.",
      "properties": {
        "panel": { "type": "string" },
        "gizmos": { "type": "array", "items": { "type": "string" } },
        "nodeTypes": { "type": "array", "items": { "type": "string" } },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "enum": ["float", "int", "bool", "enum", "curve", "color"] },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "default": {},
              "options": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["name", "type"]
          }
        }
      }
    }
  }
}
