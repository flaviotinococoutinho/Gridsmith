{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gridsmith://contracts/blueprint.commands",
  "title": "Comandos canônicos do Blueprint",
  "description": "Payload de cada comando canônico, como as bordas (JSON-RPC, GraphQL, gRPC, MCP) o recebem antes de `reshapeCommand` reconstruir o comando. FONTE DE VERDADE do conjunto de kinds: este arquivo, `COMMAND_KINDS` em middleware/src/canonical/commandShape.ts e o enum `CommandKind` do SDL devem cobrir EXATAMENTE o mesmo conjunto — o lint de contratos do `npm run docs:verify` quebra se divergirem. O enum do SDL usa o mesmo nome com `/` trocado por `_`. Este schema descreve o SHAPE aceito na borda; a validação semântica (limites, coerência entre campos, existência de referências) é do BlueprintStore e devolve InvalidParams. Kinds em $defs.",
  "$defs": {
    "skeleton/define": {
      "description": "Define um esqueleto (hierarquia de ossos com matriz inversa de bind).",
      "payload": {
        "$ref": "#/$defs/shared/skeleton"
      }
    },
    "mesh/bind": {
      "description": "Vincula uma malha a um esqueleto pelo plano de dados (shared memory).",
      "payload": {
        "$ref": "#/$defs/shared/meshBinding"
      }
    },
    "camera/configure": {
      "description": "Configura a câmera cinemática. Por padrão faz merge PARCIAL sobre o estado corrente; com `replace: true` substitui a configuração inteira — é a forma que o inverso do histórico usa para restaurar o estado anterior exato.",
      "payload": {
        "$ref": "#/$defs/shared/cameraConfigure"
      }
    },
    "light/add": {
      "description": "Acrescenta uma luz ao Blueprint.",
      "payload": {
        "$ref": "#/$defs/shared/light"
      }
    },
    "light/update": {
      "description": "Substitui INTEGRALMENTE uma luz existente (mesma forma de level/update). A substituição integral, em vez de um patch parcial, é o que dá inverso exato e preserva a ordem do documento.",
      "payload": {
        "$ref": "#/$defs/shared/light"
      }
    },
    "light/remove": {
      "description": "Remove a luz pelo id canônico.",
      "payload": {
        "type": "object",
        "properties": {
          "lightId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "lightId"
        ],
        "additionalProperties": false
      }
    },
    "entitydef/define": {
      "description": "Define o tipo de entidade (campos tipados que geram a UI do inspector) e, opcionalmente, o archetype do runtime que a materializa como ator vivo.",
      "payload": {
        "$ref": "#/$defs/shared/entityDefinition"
      }
    },
    "entitydef/update": {
      "description": "Substitui integralmente uma definição existente. Recusa trocar o archetype com instâncias vivas, e recusa update que mudaria implicitamente os campos já resolvidos das instâncias.",
      "payload": {
        "$ref": "#/$defs/shared/entityDefinition"
      }
    },
    "entitydef/remove": {
      "description": "Remove a definição. Recusa se ainda houver instâncias dela.",
      "payload": {
        "type": "object",
        "properties": {
          "entityDefId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "entityDefId"
        ],
        "additionalProperties": false
      }
    },
    "tileset/define": {
      "description": "Define o atlas de arte do projeto (grade LDtk/Tiled-like). A região de um tileId é matemática pura sobre (tileSize, columns): não há tabela por tile para divergir entre o canvas do editor e o host gráfico. Duplicata é recusada.",
      "payload": {
        "type": "object",
        "properties": {
          "tilesetId": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "description": "Referência da imagem do atlas (caminho relativo ao projeto ou id de artefato); o documento não embute bytes."
          },
          "tileSize": {
            "type": "integer",
            "minimum": 1
          },
          "columns": {
            "type": "integer",
            "minimum": 1
          },
          "tileCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Ids válidos são 0..tileCount-1; deve ser >= columns. Um tileId fora da faixa vira projeção skipped com razão, nunca exceção."
          },
          "transactionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "tilesetId",
          "image",
          "tileSize",
          "columns",
          "tileCount"
        ],
        "additionalProperties": false
      }
    },
    "tileset/remove": {
      "description": "Remove o tileset. Recusa enquanto algum nível o referenciar (sem cascata: reescrever níveis por efeito colateral quebraria o inverso único).",
      "payload": {
        "type": "object",
        "properties": {
          "tilesetId": {
            "type": "string",
            "minLength": 1
          },
          "transactionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "tilesetId"
        ],
        "additionalProperties": false
      }
    },
    "entity/place": {
      "description": "Instancia uma entidade no mundo. Campos ausentes assumem o default da definição; campo sem valor e sem default é erro.",
      "payload": {
        "$ref": "#/$defs/shared/entityInstance"
      }
    },
    "entity/move": {
      "description": "Move uma instância existente. Posição em PIXELS do mundo (contracts/schemas/actors.methods.schema.json).",
      "payload": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/$defs/shared/worldPosition"
          }
        },
        "required": [
          "entityId",
          "position"
        ],
        "additionalProperties": false
      }
    },
    "entity/properties": {
      "description": "Edita campos tipados de uma instância. Cada mudança carrega o valor ANTERIOR: se ele não bater com o estado corrente, o comando é recusado como conflito — o cliente editou sobre uma leitura velha.",
      "payload": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/shared/entityPropertyChange"
            }
          }
        },
        "required": [
          "entityId",
          "changes"
        ],
        "additionalProperties": false
      }
    },
    "entity/remove": {
      "description": "Remove a instância pelo id canônico.",
      "payload": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "entityId"
        ],
        "additionalProperties": false
      }
    },
    "level/define": {
      "description": "Cria um nível novo (IntGrid de significado + regras de auto-tiling). Rejeita id duplicado.",
      "payload": {
        "$ref": "#/$defs/shared/level"
      }
    },
    "level/update": {
      "description": "Substitui um nível existente. Mesmo shape de level/define; rejeita id inexistente.",
      "payload": {
        "$ref": "#/$defs/shared/level"
      }
    },
    "level/patch": {
      "description": "Edita células do IntGrid em lote. Exige `transactionId`: um patch é um GESTO (uma pincelada), e é o transactionId que permite ao histórico coalescer centenas de células num único item desfazível. Cada mudança carrega o valor ANTERIOR; divergência é conflito.",
      "payload": {
        "type": "object",
        "properties": {
          "levelId": {
            "type": "string",
            "minLength": 1
          },
          "transactionId": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/shared/levelCellChange"
            }
          }
        },
        "required": [
          "levelId",
          "transactionId",
          "changes"
        ],
        "additionalProperties": false
      }
    },
    "level/palette": {
      "description": "Cria, edita ou apaga entradas da paleta do nível. Cada mudança carrega a entrada ANTERIOR (ou null); divergência é conflito.",
      "payload": {
        "type": "object",
        "properties": {
          "levelId": {
            "type": "string",
            "minLength": 1
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/shared/levelPaletteChange"
            }
          }
        },
        "required": [
          "levelId",
          "changes"
        ],
        "additionalProperties": false
      }
    },
    "level/remove": {
      "description": "Remove o nível e o posicionamento correspondente no world map.",
      "payload": {
        "type": "object",
        "properties": {
          "levelId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "levelId"
        ],
        "additionalProperties": false
      }
    },
    "world/place": {
      "description": "Posiciona um nível no world map (free layout, coordenadas em pixels do mundo).",
      "payload": {
        "$ref": "#/$defs/shared/worldPlacement"
      }
    },
    "world/unplace": {
      "description": "Retira o nível do world map sem removê-lo do projeto.",
      "payload": {
        "type": "object",
        "properties": {
          "levelId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "levelId"
        ],
        "additionalProperties": false
      }
    },
    "shared": {
      "description": "Fragmentos reutilizados pelos kinds acima. NÃO é um kind — o lint de paridade ignora esta chave.",
      "worldPosition": {
        "type": "array",
        "description": "Posição no mundo em PIXELS [x, y]. Nenhuma camada converte: célula → pixel é decidido na origem.",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "skeleton": {
        "type": "object",
        "properties": {
          "skeletonId": {
            "type": "string",
            "minLength": 1
          },
          "bones": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 0
                },
                "parentId": {
                  "type": "integer",
                  "minimum": -1,
                  "description": "-1 = raiz; qualquer outro valor deve existir entre os ossos"
                },
                "inverseBindMatrix": {
                  "type": "array",
                  "description": "Matriz afim 2D coluna-maior: m11, m12, m21, m22, m31, m32",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 6,
                  "maxItems": 6
                }
              },
              "required": [
                "id",
                "parentId",
                "inverseBindMatrix"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "skeletonId",
          "bones"
        ],
        "additionalProperties": false
      },
      "meshBinding": {
        "type": "object",
        "properties": {
          "meshId": {
            "type": "string",
            "minLength": 1
          },
          "skeletonId": {
            "type": "string",
            "minLength": 1
          },
          "sharedMemoryMapName": {
            "type": "string",
            "minLength": 1
          },
          "vertexCount": {
            "type": "integer",
            "minimum": 1
          },
          "strideInBytes": {
            "type": "integer",
            "minimum": 4
          }
        },
        "required": [
          "meshId",
          "skeletonId",
          "sharedMemoryMapName",
          "vertexCount",
          "strideInBytes"
        ],
        "additionalProperties": false
      },
      "cameraSettings": {
        "type": "object",
        "properties": {
          "frequency": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "damping": {
            "type": "number",
            "minimum": 0
          },
          "response": {
            "type": "number"
          },
          "anticipationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "shakeFrequencyHz": {
            "type": "number"
          },
          "shakeMaxOffset": {
            "type": "number"
          },
          "shakeMaxRotationRadians": {
            "type": "number"
          },
          "shakeTraumaDecayPerSecond": {
            "type": "number"
          },
          "shakeSeed": {
            "type": "number"
          }
        },
        "additionalProperties": false
      },
      "light": {
        "type": "object",
        "description": "Luz do pipeline deferred. `radius` é obrigatório para point/spot; os ângulos de cone, para spot (0 < inner <= outer < 180).",
        "properties": {
          "lightId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "directional",
              "point",
              "spot"
            ]
          },
          "position": {
            "$ref": "#/$defs/shared/worldPosition"
          },
          "height": {
            "type": "number"
          },
          "direction": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "color": {
            "type": "array",
            "description": "RGB linear",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "intensity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "innerConeDegrees": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 180
          },
          "outerConeDegrees": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 180
          }
        },
        "required": [
          "lightId",
          "type",
          "color",
          "intensity"
        ],
        "additionalProperties": false
      },
      "entityFieldDef": {
        "type": "object",
        "description": "Campo tipado que gera a UI do inspector. `options` é obrigatório e não-vazio quando type = enum; `default`, quando presente, é validado contra o próprio campo.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "int",
              "float",
              "bool",
              "string",
              "enum",
              "point",
              "color"
            ]
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "type"
        ],
        "additionalProperties": false
      },
      "entityDefinition": {
        "type": "object",
        "properties": {
          "entityDefId": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "description": "Nomes únicos dentro da definição",
            "items": {
              "$ref": "#/$defs/shared/entityFieldDef"
            }
          },
          "archetypeId": {
            "type": "string",
            "minLength": 1,
            "description": "Spawn table: sem archetype a entidade é puramente editorial e a projeção explica isso com razão acionável"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "editor": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "entityDefId",
          "fields"
        ],
        "additionalProperties": false
      },
      "entityInstance": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "minLength": 1
          },
          "entityDefId": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/$defs/shared/worldPosition"
          },
          "fields": {
            "type": "object",
            "description": "Valores por campo declarado na definição; campo não declarado é erro",
            "additionalProperties": true
          }
        },
        "required": [
          "entityId",
          "entityDefId",
          "position"
        ],
        "additionalProperties": false
      },
      "autoTileRule": {
        "type": "object",
        "description": "Regra determinística de auto-tiling. `pattern` tem exatamente patternSize² células, linha-maior, centro = célula avaliada; null casa qualquer valor.",
        "properties": {
          "name": {
            "type": "string"
          },
          "patternSize": {
            "enum": [
              1,
              3,
              5
            ]
          },
          "pattern": {
            "type": "array",
            "items": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "tileIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "chance": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "patternSize",
          "pattern",
          "tileIds"
        ],
        "additionalProperties": false
      },
      "level": {
        "type": "object",
        "description": "O designer edita SIGNIFICADO (intGrid) + regras; a resolução em tiles é da projeção, pura e determinística por seed. width×height não pode exceder o limite de células do slot de tilemap da engine.",
        "properties": {
          "levelId": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "tileSize": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer"
          },
          "intGrid": {
            "type": "array",
            "description": "width×height valores linha-maior; 0 = vazio",
            "items": {
              "type": "integer"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/shared/autoTileRule"
            }
          },
          "palette": {
            "type": "array",
            "description": "Ordenada por value; ausente em documentos anteriores à v4",
            "items": {
              "$ref": "#/$defs/shared/levelPaletteEntry"
            }
          },
          "tilesetId": {
            "type": "string",
            "minLength": 1,
            "description": "Atlas que dá arte aos tiles resolvidos; deve existir via tileset/define. Ausente = sem arte escolhida (documentos anteriores à v5)."
          }
        },
        "required": [
          "levelId",
          "width",
          "height",
          "tileSize",
          "seed",
          "intGrid",
          "rules"
        ],
        "additionalProperties": false
      },
      "worldPlacement": {
        "type": "object",
        "description": "Free layout do world map; o retângulo do nível deriva de width/height × tileSize.",
        "properties": {
          "levelId": {
            "type": "string",
            "minLength": 1
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "levelId",
          "x",
          "y"
        ],
        "additionalProperties": false
      },
      "entityPropertyChange": {
        "type": "object",
        "description": "Mudança de um campo declarado, com antes e depois explícitos.",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "before": {},
          "after": {}
        },
        "required": [
          "name",
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "cameraConfigure": {
        "type": "object",
        "properties": {
          "frequency": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "damping": {
            "type": "number",
            "minimum": 0
          },
          "response": {
            "type": "number"
          },
          "anticipationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "shakeFrequencyHz": {
            "type": "number"
          },
          "shakeMaxOffset": {
            "type": "number"
          },
          "shakeMaxRotationRadians": {
            "type": "number"
          },
          "shakeTraumaDecayPerSecond": {
            "type": "number"
          },
          "shakeSeed": {
            "type": "number"
          },
          "replace": {
            "type": "boolean",
            "description": "Substitui em vez de mesclar"
          }
        },
        "additionalProperties": false
      },
      "levelCellChange": {
        "type": "object",
        "description": "Mudança de UMA célula do IntGrid, índice linha-maior (y*width+x).",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32767
          },
          "after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32767
          }
        },
        "required": [
          "index",
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "levelPaletteEntry": {
        "type": "object",
        "description": "Significado pintável: valor do IntGrid + nome e cor de exibição.",
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32767
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "required": [
          "value",
          "name",
          "color"
        ],
        "additionalProperties": false
      },
      "levelPaletteChange": {
        "type": "object",
        "description": "Mudança de UMA entrada da paleta; null significa ausência (criar ou apagar).",
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32767
          },
          "before": {
            "oneOf": [
              {
                "$ref": "#/$defs/shared/levelPaletteEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "oneOf": [
              {
                "$ref": "#/$defs/shared/levelPaletteEntry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "value",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    }
  }
}
