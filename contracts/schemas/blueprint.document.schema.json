{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p7m://contracts/blueprint.document",
  "title": "P7M BlueprintDocument v5",
  "description": "Snapshot declarativo persistido. Histórico, transactionId, actor e eventos não são persistidos; v5 adiciona uma referência SpriteRenderer opcional e reparável aos archetypes.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 5 },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "metadata": { "$ref": "#/$defs/projectMetadata" },
    "skeletons": { "type": "array", "items": { "$ref": "#/$defs/skeleton" } },
    "meshes": { "type": "array", "items": { "$ref": "#/$defs/mesh" } },
    "camera": { "$ref": "#/$defs/camera" },
    "lights": { "type": "array", "items": { "$ref": "#/$defs/light" } },
    "entityDefs": { "type": "array", "items": { "$ref": "#/$defs/entityDefinition" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "levels": { "type": "array", "items": { "$ref": "#/$defs/level" } },
    "placements": { "type": "array", "items": { "$ref": "#/$defs/worldPlacement" } }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "metadata",
    "skeletons",
    "meshes",
    "camera",
    "lights",
    "entityDefs",
    "entities",
    "levels",
    "placements"
  ],
  "additionalProperties": false,
  "$defs": {
    "finitePair": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "projectMetadata": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "referenceResolution": {
          "type": "object",
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "required": ["width", "height"],
          "additionalProperties": false
        },
        "spatial": {
          "type": "object",
          "properties": {
            "positionUnit": { "const": "world-pixel" },
            "cellOrigin": { "const": "top-left" },
            "yAxis": { "const": "down" },
            "entityAnchor": { "const": "center" }
          },
          "required": ["positionUnit", "cellOrigin", "yAxis", "entityAnchor"],
          "additionalProperties": false
        }
      },
      "required": ["name", "referenceResolution", "spatial"],
      "additionalProperties": false
    },
    "bone": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "parentId": { "type": "integer", "minimum": -1 },
        "inverseBindMatrix": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 6,
          "maxItems": 6
        }
      },
      "required": ["id", "parentId", "inverseBindMatrix"],
      "additionalProperties": false
    },
    "skeleton": {
      "type": "object",
      "properties": {
        "skeletonId": { "type": "string", "minLength": 1 },
        "bones": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/bone" } }
      },
      "required": ["skeletonId", "bones"],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "properties": {
        "meshId": { "type": "string", "minLength": 1 },
        "skeletonId": { "type": "string", "minLength": 1 },
        "sharedMemoryMapName": { "type": "string", "minLength": 1 },
        "vertexCount": { "type": "integer", "minimum": 1 },
        "strideInBytes": { "type": "integer", "minimum": 4 }
      },
      "required": ["meshId", "skeletonId", "sharedMemoryMapName", "vertexCount", "strideInBytes"],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "frequency": { "type": "number", "exclusiveMinimum": 0 },
        "damping": { "type": "number", "minimum": 0 },
        "response": { "type": "number" },
        "anticipationSeconds": { "type": "number", "minimum": 0 },
        "shakeFrequencyHz": { "type": "number", "exclusiveMinimum": 0 },
        "shakeMaxOffset": { "type": "number", "minimum": 0 },
        "shakeMaxRotationRadians": { "type": "number", "minimum": 0 },
        "shakeTraumaDecayPerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "shakeSeed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "light": {
      "type": "object",
      "properties": {
        "lightId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["directional", "point", "spot"] },
        "position": { "$ref": "#/$defs/finitePair" },
        "height": { "type": "number" },
        "direction": { "$ref": "#/$defs/finitePair" },
        "color": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
        "intensity": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "innerConeDegrees": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
        "outerConeDegrees": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 }
      },
      "required": ["lightId", "type", "color", "intensity"],
      "additionalProperties": false
    },
    "entityField": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["int", "float", "bool", "string", "enum", "point", "color"] },
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "options": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "required": ["name", "type"],
      "additionalProperties": false
    },
    "entityDefinition": {
      "type": "object",
      "properties": {
        "entityDefId": { "type": "string", "minLength": 1 },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/entityField" } },
        "archetypeId": { "type": "string", "minLength": 1 },
        "spriteRenderer": {
          "type": "object",
          "properties": {
            "assetId": { "type": "string", "minLength": 1 },
            "defaultClip": { "type": "string", "minLength": 1 }
          },
          "required": ["assetId"],
          "additionalProperties": false
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "editor": {
          "type": "object",
          "properties": {
            "color": { "type": "string" },
            "icon": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "required": ["entityDefId", "fields"],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "entityId": { "type": "string", "minLength": 1 },
        "entityDefId": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/finitePair" },
        "fields": { "type": "object" }
      },
      "required": ["entityId", "entityDefId", "position", "fields"],
      "additionalProperties": false
    },
    "autoTileRule": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "patternSize": { "enum": [1, 3, 5] },
        "pattern": { "type": "array", "items": { "type": ["integer", "null"] } },
        "tileIds": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "chance": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "required": ["patternSize", "pattern", "tileIds"],
      "additionalProperties": false
    },
    "paletteEntry": {
      "type": "object",
      "properties": {
        "value": { "type": "integer", "minimum": 1, "maximum": 32767 },
        "name": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      },
      "required": ["value", "name", "color"],
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "properties": {
        "levelId": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tileSize": { "type": "integer", "minimum": 1, "maximum": 256 },
        "seed": { "type": "integer" },
        "intGrid": {
          "type": "array",
          "maxItems": 65536,
          "items": { "type": "integer", "minimum": 0, "maximum": 32767 }
        },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/autoTileRule" } },
        "palette": { "type": "array", "items": { "$ref": "#/$defs/paletteEntry" } }
      },
      "required": ["levelId", "width", "height", "tileSize", "seed", "intGrid", "rules", "palette"],
      "additionalProperties": false
    },
    "worldPlacement": {
      "type": "object",
      "properties": {
        "levelId": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "required": ["levelId", "x", "y"],
      "additionalProperties": false
    }
  }
}
